# All paths are local. Relative paths resolve from backend/, not the shell cwd.
LOCAL_STUDIO_DATA_DIR=data
LOCAL_STUDIO_FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# Includes time waiting in the local queue. Future adapters must honor cancellation.
LOCAL_STUDIO_JOB_TIMEOUT_SECONDS=300
LOCAL_STUDIO_MAX_PENDING_JOBS=8
LOCAL_STUDIO_MAX_CONCURRENT_JOBS=1
LOCAL_STUDIO_MAX_REQUEST_BYTES=65536
LOCAL_STUDIO_MAX_OUTPUT_BYTES=104857600
# Opt-in HTTP GPU worker; blank URL means no remote calls and no inference.
# Configure only a service you are authorized to use for inference hosting.
# Non-loopback worker origins require HTTPS and a server-side bearer token.
LOCAL_STUDIO_REMOTE_WORKER_URL=
LOCAL_STUDIO_REMOTE_WORKER_TOKEN=
LOCAL_STUDIO_REMOTE_WORKER_MODEL=stable-diffusion-v1-5
# Readiness/JSON probes have a total deadline; maximum 5 seconds.
LOCAL_STUDIO_WORKER_REQUEST_TIMEOUT_SECONDS=5
LOCAL_STUDIO_WORKER_POLL_INTERVAL_SECONDS=1
# Worker-side contract and activation steps: docs/GPU_WORKER_INTEGRATION.md
